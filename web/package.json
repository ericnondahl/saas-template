{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev --host --port 3000",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "email:dev": "email dev --dir app/emails --port 3001",
    "worker": "tsx scripts/worker.ts",
    "format": "prettier --write --log-level error .",
    "format:check": "prettier --check .",
    "check": "npm run format && npm run typecheck && npm run test && npm run build",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@clerk/react-router": "^3.4.1",
    "@openrouter/sdk": "^0.12.79",
    "@radix-ui/react-slot": "^1.2.5",
    "@react-email/components": "^1.0.12",
    "@react-router/node": "7.17.0",
    "@react-router/serve": "7.17.0",
    "bullmq": "^5.78.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.40.0",
    "ioredis": "^5.11.1",
    "isbot": "^5.1.42",
    "lucide-react": "^1.17.0",
    "pg": "^8.21.0",
    "posthog-js": "^1.386.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-email": "^6.6.0",
    "react-router": "7.17.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@react-email/preview-server": "^5.2.11",
    "@react-email/ui": "^6.6.0",
    "@react-router/dev": "7.17.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.18"
  }
}
