{
  "name": "@saas-template/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared types and utilities for SaaS template",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --log-level error .",
    "format:check": "prettier --check .",
    "check": "npm run format && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  }
}
