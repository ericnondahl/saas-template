{
  "name": "@saas-template/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "REACT_NATIVE_PACKAGER_HOSTNAME=$(ipconfig getifaddr en0) expo run:ios --device",
    "android:device": "REACT_NATIVE_PACKAGER_HOSTNAME=$(ipconfig getifaddr en0) expo run:android --device",
    "prebuild": "expo prebuild",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --log-level error .",
    "format:check": "prettier --check .",
    "check": "npm run format && npm run typecheck && npm run test",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "submit:ios": "eas build --platform ios --profile production --auto-submit",
    "submit:android": "eas build --platform android --profile production --auto-submit",
    "build:ios:local": "eas build --profile preview --local --platform ios",
    "build:ios:local:dev": "eas build --profile preview-dev --local --platform ios",
    "build:android:local": "eas build --profile preview --local --platform android",
    "build:android:local:dev": "eas build --profile preview-dev --local --platform android"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.2.5",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.18",
    "@saas-template/shared": "file:../packages/shared",
    "expo": "~52.0.0",
    "expo-apple-authentication": "~7.1.3",
    "expo-application": "~6.0.2",
    "expo-constants": "~17.0.3",
    "expo-crypto": "~14.0.0",
    "expo-dev-client": "~5.0.4",
    "expo-device": "~7.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.0",
    "expo-linking": "~7.0.3",
    "expo-localization": "~16.0.1",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.15",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.4",
    "expo-web-browser": "~14.0.0",
    "posthog-react-native": "^4.22.0",
    "posthog-react-native-session-replay": "^1.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^20.11.0",
    "@types/react": "~18.3.12",
    "@types/react-native": "^0.73.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  },
  "private": true
}
