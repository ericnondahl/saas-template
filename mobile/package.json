{
  "name": "@saas-template/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "REACT_NATIVE_PACKAGER_HOSTNAME=$(ipconfig getifaddr en0) expo run:ios --device",
    "android:device": "REACT_NATIVE_PACKAGER_HOSTNAME=$(ipconfig getifaddr en0) expo run:android --device",
    "prebuild": "expo prebuild",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --log-level error .",
    "format:check": "prettier --check .",
    "check": "npm run format && npm run typecheck && npm run test",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "submit:ios": "eas build --platform ios --profile production --auto-submit",
    "submit:android": "eas build --platform android --profile production --auto-submit",
    "build:ios:local": "eas build --profile preview --local --platform ios",
    "build:ios:local:dev": "eas build --profile preview-dev --local --platform ios",
    "build:android:local": "eas build --profile preview --local --platform android",
    "build:android:local:dev": "eas build --profile preview-dev --local --platform android"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.2.5",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@saas-template/shared": "file:../packages/shared",
    "expo": "^56.0.0",
    "expo-apple-authentication": "~56.0.4",
    "expo-application": "~56.0.3",
    "expo-auth-session": "~56.0.14",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.20",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.6",
    "expo-linking": "~56.0.14",
    "expo-localization": "~56.0.6",
    "expo-router": "~56.2.10",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "posthog-react-native": "^4.46.30",
    "posthog-react-native-session-replay": "^1.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/node": "^22",
    "@types/react": "~19.2.0",
    "prettier": "^3.8.4",
    "typescript": "~6.0.3",
    "vitest": "^4.0.18"
  },
  "private": true
}
