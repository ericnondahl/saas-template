# Clerk Authentication
# Only the publishable key is needed on the mobile app
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API URL for user sync (the web app's dev server)
# iOS Simulator: use http://localhost:3000
# Android emulator: use http://10.0.2.2:3000 (the emulator's alias for the host machine — localhost is the emulator itself)
# Physical device: use your computer's local IP (e.g., http://192.168.1.100:3000)
EXPO_PUBLIC_API_URL=http://localhost:3000

# PostHog Analytics
EXPO_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com